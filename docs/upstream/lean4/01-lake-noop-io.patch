 /-- Load a hash from a `.hash` file. -/
 public def load? (hashFile : FilePath) : BaseIO (Option Hash) :=
-  ofString? <$> IO.FS.readFile hashFile |>.catchExceptions fun _ => pure none
+  (do
+    -- A hash file holds 16 bytes; reading one more rejects longer contents.
+    -- Unlike `IO.FS.readFile`, this does not first `stat` the file for its size.
+    let bytes ← (← IO.FS.Handle.mk hashFile .read).read 17
+    return String.fromUTF8? bytes >>= ofString?)
+  |>.catchExceptions fun _ => pure none
 
 @[inline] public def mix (h1 h2 : Hash) : Hash :=
   mk <| mixHash h1.val h2.val
