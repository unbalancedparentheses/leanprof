+/-- Reads each artifact's modification time from the file system. -/
+def ModuleOutputArtifacts.readMTimes (self : ModuleOutputArtifacts) : BaseIO ModuleOutputArtifacts := do
+  let read (art : Artifact) : BaseIO Artifact := do
+    return {art with mtime := (← getMTime art.path |>.toBaseIO).toOption.getD 0}
+  return {self with
+    olean := ← read self.olean
+    oleanServer? := ← self.oleanServer?.mapM read
+    oleanPrivate? := ← self.oleanPrivate?.mapM read
+    ilean := ← read self.ilean
+    irSig? := ← self.irSig?.mapM read
+    ir? := ← self.ir?.mapM read
+    c := ← read self.c
+    bc? := ← self.bc?.mapM read
+  }
+
