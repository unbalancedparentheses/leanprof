#!/bin/sh
# C compiler wrapper for Lake: set LEAN_CC to this script and every package's
# C code (dependencies too) is compiled with leanprof's copy and task shims.
# On Linux it forwards to Lean's own leanc (with LEAN_CC unset, so that leanc
# uses its bundled clang, sysroot and linker): the profiled program is then
# compiled and linked like the one Lake builds. Built by the system's clang
# and linker instead, the copy benchmark ran 18% faster with no probes at
# all, which leanprof then reported as time its probes had taken.
# Elsewhere, and for sanitizer builds (which need the system's sanitizer
# runtimes), it forwards to the system compiler (LEANPROF_REAL_CC overrides
# both): with LEAN_CC set, leanc no longer passes its bundled clang's sysroot.
# clang is preferred (GCC lacks -finstrument-functions-after-inlining), but
# not the toolchain's own, which Lake puts first on PATH and which has no
# system headers.
prefix="$(lean --print-prefix)"
real="${LEANPROF_REAL_CC:-}"
if [ -z "$real" ] && [ -z "${LEANPROF_SANITIZE:-}" ] && [ "$(uname -s)" = Linux ] && [ -x "$prefix/bin/leanc" ]; then
  real=leanc_bundled
fi
if [ -z "$real" ]; then
  real=cc
  old_ifs=$IFS; IFS=:
  for d in $PATH; do
    [ "$d" = "$prefix/bin" ] && continue
    if [ -x "$d/clang" ]; then real="$d/clang"; break; fi
  done
  IFS=$old_ifs
fi
set -- \
  -Dlean_copy_expand_array_nonlinear=leanprof_copy_expand_array_nonlinear \
  -Dlean_copy_expand_array=leanprof_copy_expand_array \
  -Dlean_copy_sarray_nonlinear=leanprof_copy_sarray_nonlinear \
  -Dlean_copy_string_nonlinear=leanprof_copy_string_nonlinear \
  -Dlean_copy_byte_array=leanprof_copy_byte_array \
  -Dlean_copy_float_array=leanprof_copy_float_array \
  -Dlean_array_push=leanprof_array_push \
  -Dlean_byte_array_push=leanprof_byte_array_push \
  -Dlean_float_array_push=leanprof_float_array_push \
  -Dlean_string_push=leanprof_string_push \
  -Dlean_string_push_cold=leanprof_string_push_cold \
  -Dlean_string_append=leanprof_string_append \
  -Dlean_string_utf8_set=leanprof_string_utf8_set \
  -Dlean_task_spawn_core=leanprof_task_spawn_core \
  -Dlean_io_as_task=leanprof_io_as_task \
  -Dlean_io_wait=leanprof_io_wait \
  -Dlean_task_get=leanprof_task_get \
  -Dlean_task_map_core=leanprof_task_map_core \
  -Dlean_task_bind_core=leanprof_task_bind_core \
  -Dlean_io_map_task=leanprof_io_map_task \
  -Dlean_io_bind_task=leanprof_io_bind_task \
  "$@"
# LEANPROF_ALLOCS=1 also counts allocations made by compiled Lean code.
if [ "${LEANPROF_ALLOCS:-}" = 1 ]; then
  set -- \
    -Dlean_alloc_small_object_core=leanprof_alloc_small_object_core \
    -Dlean_alloc_object=leanprof_alloc_object \
    -Dmi_malloc=leanprof_mi_malloc \
    -Dmi_malloc_small=leanprof_mi_malloc_small \
    "$@"
fi
# LEANPROF_COUNTERS=1 also counts failed constructor reuse and closure
# applications (c/counters.h redirects lean_is_exclusive and lean_apply_*).
if [ "${LEANPROF_COUNTERS:-}" = 1 ]; then
  case " $* " in
    *" -c "*) set -- -include "$(cd "$(dirname "$0")/.." && pwd)/c/counters.h" "$@" ;;
  esac
fi
# LEANPROF_FREES=1 also times freeing cascades and counts atomic decrements
# of multi-threaded objects, per call site.
if [ "${LEANPROF_FREES:-}" = 1 ]; then
  set -- -Dlean_dec_ref_cold=leanprof_dec_ref_cold "$@"
fi
# LEANPROF_WHY=1 also records where Arrays and Strings become shared, for
# `leanprof explain` (c/leanprof_why.h wraps lean_inc after lean.h).
if [ "${LEANPROF_WHY:-}" = 1 ]; then
  case " $* " in
    *" -c "*) set -- -include lean/lean.h -include "$(cd "$(dirname "$0")/.." && pwd)/c/leanprof_why.h" "$@" ;;
  esac
fi
# LEANPROF_AUTO=1 also times every function of this package (no `profile!`
# needed); LEANPROF_AUTO=all includes dependencies.
# LEANPROF_SANITIZE=address,undefined (or thread) builds with sanitizers, for
# leanprof's CI (the lakefile compiles leanprof's runtime with the same ones).
# Lean's own runtime and libraries are precompiled and stay uninstrumented.
# For `thread`, the emitted C is not instrumented either, only linked with
# TSan: its threads synchronize through the runtime's atomics, which TSan
# cannot see, so it would only report false races between Lean objects.
if [ -n "${LEANPROF_SANITIZE:-}" ]; then
  case "$LEANPROF_SANITIZE: $* " in
    *thread*" -c "*) ;;
    *) set -- "-fsanitize=$LEANPROF_SANITIZE" -fno-omit-frame-pointer -g "$@" ;;
  esac
fi
timed=
case " $* " in
  *" -c "*)
    case "${LEANPROF_AUTO:-}:$*" in
      all:*) timed=1 ;;
      1:*/.lake/packages/*) ;;
      1:*) timed=1 ;;
    esac ;;
esac
# Functions too small to time (straight-line code calling only O(1)
# operations, see leanprof-tiny.awk) are left out of --auto, unless
# LEANPROF_AUTO_TINY=1: their probes would cost several times their work,
# in their own time and in that of every function around them. The source
# is rewritten into a temporary copy with those functions marked.
tmpdir=
if [ -n "$timed" ]; then
  set -- -finstrument-functions-after-inlining "$@"
  if [ "${LEANPROF_AUTO_TINY:-}" != 1 ]; then
    src=
    for a in "$@"; do
      case "$a" in *.c) [ -f "$a" ] && src=$a ;; esac
    done
    if [ -n "$src" ] && tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/leanprof-cc.XXXXXX")"; then
      out="$tmpdir/$(basename "$src")"
      if awk -f "$(cd "$(dirname "$0")" && pwd)/leanprof-tiny.awk" "$src" > "$out" &&
          grep -q '^static void \*const lpf_untimed_fns' "$out"; then
        for a in "$@"; do
          shift
          if [ "$a" = "$src" ]; then set -- "$@" "$out"; else set -- "$@" "$a"; fi
        done
        # quoted includes still resolve next to the original
        set -- -iquote "$(dirname "$src")" "$@"
      fi
    fi
  fi
fi
# When linking, export symbols so the report can name functions,
# find the toolchain's static libraries (gmp, libuv, ...), and link
# leanprof's runtime into projects that do not depend on leanprof
# (LEANPROF_RUNTIME, set by `leanprof run`), unless the link already has
# leanprof's runtime library (a checkout of leanprof itself): GNU ld would
# then see every symbol twice. LEANPROF_CORE_LIB (`run --core`) is searched
# first, so -lInit -lStd -lLean find the rewritten copies there.
case " $* " in
  *" -c "*) ;;
  *)
    runtime="${LEANPROF_RUNTIME:-}"
    if [ -n "$runtime" ]; then
      for a in "$@"; do
        case "$a" in
          *libleanprof_c.a) runtime= ;;
          @*) grep -q 'libleanprof_c\.a' "${a#@}" 2>/dev/null && runtime= ;;
        esac
      done
    fi
    set -- ${LEANPROF_CORE_LIB:+"-L$LEANPROF_CORE_LIB"} -rdynamic "-L$prefix/lib" "$@" ${runtime:+"$runtime"} ;;
esac
if [ "$real" = leanc_bundled ]; then
  unset LEAN_CC
  real="$prefix/bin/leanc"
fi
if [ -z "$tmpdir" ]; then
  exec "$real" "$@"
fi
"$real" "$@"
rc=$?
rm -rf "$tmpdir"
exit $rc
